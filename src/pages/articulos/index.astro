---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles } from '../../data/content';
---
<BaseLayout title="Artículos sobre IA, SEO y automatización | aitoralmu.xyz" description="Guías y análisis prácticos para elegir herramientas digitales y construir proyectos mejores.">
  <main class="min-h-screen"><header class="mx-auto flex max-w-6xl items-center justify-between px-6 py-7"><a href="/" class="text-xl font-bold tracking-tight">aitor<span class="text-coral">almu</span><span class="text-cobalt">.</span></a><a href="/" class="text-sm font-bold">← Volver al inicio</a></header>
    <section class="mx-auto max-w-6xl px-6 pb-20 pt-16"><p class="text-sm font-bold uppercase tracking-[.18em] text-coral">Cuaderno de pruebas</p><h1 class="mt-4 max-w-3xl text-6xl font-bold leading-none">Ideas claras para decisiones digitales.</h1><p class="mt-7 max-w-2xl text-lg leading-8 text-ink/70">Análisis, tutoriales y marcos de decisión basados en herramientas que hemos probado y comparado.</p><div class="mt-14 grid gap-5 md:grid-cols-3">{articles.map(article => <article class={`rounded-[1.5rem] p-7 ${article.accent}`}><p class="text-xs font-bold uppercase tracking-widest opacity-70">{article.category}</p><h2 class="mt-16 text-3xl font-bold leading-tight">{article.title}</h2><p class="mt-5 leading-7 opacity-75">{article.excerpt}</p><div class="mt-8 flex items-center justify-between text-sm font-bold"><span>{article.readTime} de lectura</span><a href={`/articulos/${article.slug}`}>Leer →</a></div></article>)}</div></section>
  </main>
</BaseLayout>
