---
import BaseLayout from '../layouts/BaseLayout.astro';
const pillars = [
  { tag: 'IA aplicada', title: 'Usa la IA para crear cosas que funcionan.', text: 'Flujos probados, comparativas honestas y plantillas listas para trabajar, publicar y vender.', color: 'bg-mint' },
  { tag: 'SEO y GEO', title: 'Haz que te encuentren personas y máquinas.', text: 'Sistemas prácticos para ganar visibilidad en buscadores y motores de respuesta.', color: 'bg-white' },
  { tag: 'Web y automatización', title: 'Construye tu stack sin perder semanas.', text: 'Decisiones claras sobre webs, hosting, no-code y automatizaciones para proyectos reales.', color: 'bg-coral text-white' }
];
---
<BaseLayout>
  <main class="min-h-screen">
    <header class="mx-auto flex max-w-6xl items-center justify-between px-6 py-7">
      <a href="/" class="text-xl font-bold tracking-tight">aitor<span class="text-coral">almu</span><span class="text-cobalt">.</span></a>
      <nav class="hidden gap-8 text-sm font-medium md:flex"><a href="/articulos/">Artículos</a><a href="/herramientas/">Herramientas</a><a href="#metodo">Método</a></nav>
      <a href="#newsletter" class="rounded-full bg-ink px-5 py-3 text-sm font-bold text-white">Recibir recursos</a>
    </header>
    <section class="mx-auto grid max-w-6xl gap-12 px-6 pb-24 pt-16 md:grid-cols-[1.1fr_.9fr] md:items-center md:pt-24">
      <div>
        <p class="mb-6 inline-flex rounded-full border border-ink/15 px-4 py-2 text-xs font-bold uppercase tracking-[.18em]">Tecnología digital sin humo</p>
        <h1 class="max-w-3xl text-6xl font-bold leading-[.95] md:text-8xl">Elige mejor.<br /><span class="text-coral">Construye</span> más rápido.</h1>
        <p class="mt-8 max-w-xl text-lg leading-8 text-ink/70">Pruebas, comparativas y herramientas para elegir y automatizar tu stack digital. Menos ruido. Más resultados que puedas comprobar.</p>
        <div class="mt-10 flex flex-wrap gap-4"><a href="#pilares" class="rounded-full bg-cobalt px-6 py-4 font-bold text-white">Explorar el laboratorio →</a><a href="#metodo" class="rounded-full border border-ink/20 px-6 py-4 font-bold">Cómo trabajamos</a></div>
      </div>
      <div class="relative rounded-[2rem] bg-ink p-7 text-white shadow-2xl shadow-cobalt/10">
        <div class="absolute -right-4 -top-5 rounded-full bg-coral px-4 py-2 text-xs font-bold">pruebas reales</div>
        <div class="mb-8 flex items-center justify-between border-b border-white/15 pb-5"><span class="font-bold">stack recomendado</span><span class="rounded-full bg-mint px-3 py-1 text-xs font-bold text-ink">actualizado</span></div>
        <div class="space-y-4"><div class="rounded-2xl bg-white/10 p-5"><p class="text-xs uppercase tracking-widest text-mint">01 · Descubrir</p><p class="mt-2 text-xl font-bold">Qué herramienta encaja contigo</p></div><div class="ml-8 rounded-2xl bg-cobalt p-5"><p class="text-xs uppercase tracking-widest text-white/70">02 · Comparar</p><p class="mt-2 text-xl font-bold">Coste real, límites y resultados</p></div><div class="rounded-2xl bg-coral p-5"><p class="text-xs uppercase tracking-widest text-white/70">03 · Ejecutar</p><p class="mt-2 text-xl font-bold">Plantillas y flujos listos</p></div></div>
      </div>
    </section>
    <section id="pilares" class="bg-white px-6 py-24"><div class="mx-auto max-w-6xl"><p class="text-sm font-bold uppercase tracking-[.18em] text-coral">El laboratorio</p><h2 class="mt-4 max-w-2xl text-5xl font-bold">Todo lo necesario para tomar decisiones digitales con criterio.</h2><div class="mt-14 grid gap-5 md:grid-cols-3">{pillars.map((pillar, i) => <article class={`rounded-[1.5rem] p-7 ${pillar.color}`}><span class="text-xs font-bold uppercase tracking-widest opacity-70">0{i + 1} / {pillar.tag}</span><h3 class="mt-16 text-3xl font-bold">{pillar.title}</h3><p class="mt-5 leading-7 opacity-75">{pillar.text}</p><a href="#newsletter" class="mt-8 inline-block font-bold">Ver recursos →</a></article>)}</div></div></section>
    <section id="metodo" class="mx-auto grid max-w-6xl gap-10 px-6 py-24 md:grid-cols-[.8fr_1.2fr]"><div><p class="text-sm font-bold uppercase tracking-[.18em] text-cobalt">Nuestro método</p><h2 class="mt-4 text-5xl font-bold">La opinión empieza después de la prueba.</h2></div><div class="space-y-4">{['Mismo caso de uso para comparar herramientas.', 'Precios, límites y privacidad explicados sin letra pequeña.', 'Resultado visible: tutorial, plantilla o herramienta que puedas usar.', 'Fecha de revisión para que el contenido no se quede obsoleto.'].map((item, i) => <div class="flex gap-5 border-b border-ink/15 py-5"><span class="font-bold text-coral">0{i + 1}</span><p class="text-xl font-medium">{item}</p></div>)}</div></section>
    <section id="newsletter" class="bg-mint px-6 py-20"><div class="mx-auto max-w-3xl text-center"><p class="text-sm font-bold uppercase tracking-[.18em]">Próximamente</p><h2 class="mt-4 text-5xl font-bold">Recibe herramientas que te ahorran trabajo.</h2><p class="mx-auto mt-5 max-w-xl text-lg text-ink/70">Comparativas nuevas, flujos probados y recursos gratuitos. Sin ruido y con una aplicación clara.</p><form class="mx-auto mt-8 flex max-w-lg flex-col gap-3 sm:flex-row"><input class="min-h-14 flex-1 rounded-full border-0 px-6 outline-none" type="email" placeholder="tu@email.com" aria-label="Email" /><button class="rounded-full bg-ink px-7 py-4 font-bold text-white">Apuntarme</button></form></div></section>
    <footer class="mx-auto flex max-w-6xl flex-col gap-3 px-6 py-8 text-sm text-ink/60 sm:flex-row sm:items-center sm:justify-between"><span>© 2026 aitoralmu.xyz</span><span>La tecnología se entiende mejor cuando se prueba.</span></footer>
  </main>
</BaseLayout>
